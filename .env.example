# LLM
# Default: use the GitHub Actions / cloud Gemini path.
# Set USE_LOCAL_LLM=true only for explicit local Ollama runs.
GEMINI_API_KEY=
USE_LOCAL_LLM=false
OLLAMA_MODEL=gemma4:e4b

# KakaoTalk
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_AUTH_CODE=
KAKAO_REDIRECT_URI=https://example.com/oauth

# Local runtime
TOP_STORY_COUNT=5
